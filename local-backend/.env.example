# MongoDB local — se instala en la misma PC que el cliente
MONGO_URI=mongodb://localhost:27017/esse_local

# Debe ser el MISMO secreto que usa el backend central para firmar los JWT
JWT_SECRET=esse_secret_key_2024

# URL del backend central (para verificar premium y obtener tokens OAuth)
CENTRAL_API=https://api.esse-analytics.com

PORT=4000

# ── Modo Laboratorio (solo desarrollo, ver lab-backend/README.md) ───────────
# Con ESSENALYTICS_LAB_MODE=1: SQLite pasa a esse_lab.db (aislada de la real),
# los 3 uploaders usan simulación en vez de llamar a las APIs reales, y
# CENTRAL_API/auth-proxy dejan de apuntar a la central real -- todo pasa a
# hablar con LAB_API (el backend de Laboratorio compartido con iOS/Android).
# Dejar en 0/comentado para el flujo real de siempre.
# ESSENALYTICS_LAB_MODE=1
# 127.0.0.1 y no "localhost" -- ver la nota en config.ts (bug de resolución
# IPv6 de Node en Windows). Para un lab-backend en otra PC de la LAN, usar su IP.
# LAB_API=http://127.0.0.1:5055
