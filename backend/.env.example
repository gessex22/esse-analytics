# ─── Servidor ──────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# ─── Base de datos ─────────────────────────────────────────────────
# Local (recomendado para self-hosted):
MONGO_URI=mongodb://localhost:27017/renders_manager
# Atlas (nube):
# MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/renders_manager

# ─── YouTube (console.cloud.google.com) ────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/youtube/auth/callback

# ─── Instagram / Meta (developers.facebook.com) ────────────────────
# Flujo: Facebook Login for Business (Page Access Token + Cuenta de Instagram
# Business vinculada a la Página) — requiere agregar el producto "Facebook
# Login for Business" a esta misma Meta App y pedir los permisos
# pages_show_list, pages_read_engagement, instagram_basic,
# instagram_content_publish, business_management. Registrar META_REDIRECT_URI
# como redirect URI válido del producto.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/instagram/auth/callback
# Configurations → Create configuration → copiar el Configuration ID.
META_LOGIN_CONFIG_ID=
# INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET: no usados por este flujo (eran del
# login viejo "Instagram Business Login", que no soporta subida resumable).

# ─── TikTok (developers.tiktok.com) ────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/tiktok/auth/callback

# ─── Biblioteca remota (owner-only, ver Parte C del plan) ───────────
# Carpeta donde se guardan de verdad los videos subidos vía
# /api/remote-library/videos -- opcional, si no está seteada usa
# ~/.esse-analytics-central/remote-library.
CENTRAL_REMOTE_LIBRARY_DIR=

# ─── Consolidación files/backup_files (docs/mongo-collections-consolidation-plan-2026-09-02.md) ───
# BACKUP_CANONICAL_READS: gatea los 3 GET de /api/backup para que lean desde
# `files` en exclusiva en vez de mergear con `backup_files`. Default 'false'
# (cualquier valor distinto de 'true') -- NO activar en producción real hasta
# que la comparación canary (CANARY_USER_IDS) cierre sin diferencias.
BACKUP_CANONICAL_READS=false
# CANARY_USER_IDS: userIds (no usernames) separados por coma que participan
# de la comparación en paralelo legacy-vs-canónico de la Entrega C. Vacío por
# default -- sin esto, el comparador es un no-op total y no pega a Mongo.
CANARY_USER_IDS=
