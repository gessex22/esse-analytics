# Copiar a .env. Sin ESSENALYTICS_LAB_MODE=1 el servidor se niega a arrancar
# (ver src/server.ts) -- es la única forma de habilitarlo, a propósito.
ESSENALYTICS_LAB_MODE=1

PORT=5055

# Dónde persiste el store JSON del Laboratorio (usuarios/catálogo/historial mock).
# Default: lab-backend/lab-data/lab.json -- NUNCA es esse_local.db ni Mongo real.
# LAB_DATA_DIR=./lab-data

# Secreto de los JWT que emite el Laboratorio. Deliberadamente DISTINTO del
# JWT_SECRET de backend/ y local-backend/ -- un token de Laboratorio nunca debe
# poder validarse contra la central real, ni viceversa.
# LAB_JWT_SECRET=esse_lab_secret_never_use_in_prod

# CORS: en LAN normalmente no hace falta tocarlo (los clientes son apps nativas
# o Electron, no un navegador con origin propio), pero si probás el panel admin
# desde otro host agregá su origin acá separado por comas.
# ALLOWED_ORIGINS=http://localhost:5055
